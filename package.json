{
  "name": "reeda",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"const fs=require('fs');const r=JSON.parse(fs.readFileSync('dist/_routes.json','utf8'));r.exclude=['/static/*','/dict/*'];fs.writeFileSync('dist/_routes.json',JSON.stringify(r));\"",
    "preview": "wrangler pages dev dist --d1=reeda-production --local --ip 0.0.0.0 --port 3000",
    "deploy": "npm run build && wrangler pages deploy dist --project-name reeda",
    "db:migrate:local": "wrangler d1 migrations apply reeda-production --local",
    "db:seed": "wrangler d1 execute reeda-production --local --file=./seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed"
  },
  "dependencies": {
    "hono": "^4.12.8",
    "kuromoji": "^0.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260317.1",
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.2",
    "vite": "^6.3.5",
    "wrangler": "^4.4.0"
  }
}
